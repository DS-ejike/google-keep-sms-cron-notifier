# App behavior
KEEP_BACKEND=mock
KEEP_MOCK_NOTES_FILE=demo/notes.json
KEEP_FILTER_LABEL=
DRY_RUN=true
NOTIFY_EXISTING=false
LOG_LEVEL=INFO

# State and runtime files
STATE_FILE=.state/keep-sms-cron.json
LOCK_FILE=.state/keep-sms-cron.lock
LOG_FILE=.state/keep-sms-cron.log

# Google Keep via gkeepapi
KEEP_GOOGLE_EMAIL=you@example.com
KEEP_MASTER_TOKEN=replace-me
KEEP_DEVICE_ID=

# Twilio SMS
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+15555550100
TWILIO_TO_NUMBER=+15555550101

